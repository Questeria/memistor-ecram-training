    "59: uint64_t counter_offset = ((numel - 1) / (block_size * grid.x * unroll_factor) + 1) * max_generator_offsets_per_curand_call;",
    "123: auto [counter_offset, grid, block] = calc_execution_policy(numel, unroll_factor);"
